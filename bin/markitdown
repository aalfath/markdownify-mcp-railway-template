#!/app/.venv/bin/python
"""markitdown CLI with Railway-friendly limits.

- Railway shows 32 host CPUs inside a 1 vCPU service, and onnxruntime (used by
  markitdown's file-type detector, magika) starts one thread per CPU. Cap it.
- Mark this child as the first thing the kernel kills if a huge file runs the
  container out of memory, so the MCP server stays up and the tool call fails.
"""
import os
import sys

try:
    with open("/proc/self/oom_score_adj", "w") as f:
        f.write("1000")
except OSError:
    pass

_threads = max(1, int(os.environ.get("MD_THREADS", "1") or "1"))

import onnxruntime as _rt  # noqa: E402

_Orig = _rt.InferenceSession


class _CappedSession(_Orig):
    def __init__(self, path_or_bytes, sess_options=None, *args, **kwargs):
        if sess_options is None:
            sess_options = _rt.SessionOptions()
        sess_options.intra_op_num_threads = _threads
        sess_options.inter_op_num_threads = 1
        super().__init__(path_or_bytes, sess_options, *args, **kwargs)


_rt.InferenceSession = _CappedSession

from markitdown.__main__ import main  # noqa: E402

sys.exit(main())
